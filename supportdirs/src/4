use std::env::{self, current_exe};
use std::path::{Path, PathBuf};
use std::fs::create_dir;

fn verify_app_folder_state(exe_path: &PathBuf) -> Result<(),Box<dyn std::error::Error>> {
    let app_dir = exe_path.parent().expect("Cannot reach parent folder!");
    let config_dir = app_dir.join("config");
    let log_dir = app_dir.join("logs");
    if config_dir.exists() {
        println!("Configuration directory in place: {:?}",config_dir);
    } else {
        eprintln!("The configuration directory does not exist, attempting to create!");
        create_dir(&config_dir)?;
    }
    if log_dir.exists() {
        println!("The logs directory is in place: {:?}",log_dir);
    } else {
        eprintln!("The logs directory does not exist, attempting to create!");
        create_dir(&log_dir)?;
    }
    Ok(())
}

fn main() {
    let executable_path = current_exe().expect("Cannot access binary!");

    match verify_app_folder_state(&executable_path) {
        Ok(()) => println!("Folder state is ready!"),
        Err(e) => panic!("Folder state is incomplete: {}",e)
    }
    println!("Executable: {:?}",executable_path);
}
